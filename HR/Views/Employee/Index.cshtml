@model List<Employee>

<div class="container mt-4">
    <div class="d-flex justify-content-end mb-3">
        <a href="/employee/add" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Employee
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Employee Name</th>
                    <th>Department Name</th>
                    <th>Salary</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Employee employee in Model)
                {
                    <tr>
                        <td>@employee.employeeName</td>
                        <td>@string.Join(", ", employee.employeeDepartments.Select(x => x.department.departmentName))</td>
                        <td>@employee.salary</td>
                        <td class="text-center">
                            <a asp-controller="employee" asp-action="edit" asp-route-employeeId="@employee.employeeId" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>