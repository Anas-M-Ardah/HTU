@model HR.EmployeeDTO
@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container">
    <h2>Edit Employee</h2>
    
    <form asp-action="EditEmp">
        <div class="form-group">
            <input asp-for="employeeId" type="hidden" />

            <div class="mb-3">
                <label asp-for="employeeName" class="form-label">Name</label>
                <input asp-for="employeeName" class="form-control" />
                <span asp-validation-for="employeeName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="salary" class="form-label">Salary</label>
                <input asp-for="salary" class="form-control" />
                <span asp-validation-for="salary" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="departments" class="form-label">Departments</label>
                <select name="employeeDepartments" multiple class="form-control">
                    @foreach (var department in Model.departments)
                    {
                        bool isSelected = Model.employeeDepartments?
                            .Any(ed => ed.departmentId == department.departmentId) ?? false;

                        if (isSelected)
                        {
                            <option selected value="@department.departmentId">@department.departmentName</option>
                        }
                        else
                        {
                            <option value="@department.departmentId">@department.departmentName</option>
                        }
                    }
                </select>
                <span asp-validation-for="departments" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Update Employee</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </form>
</div>

