@{
    Student student = ViewBag.Student;
    List<Course> courses = ViewBag.Courses;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Update Student</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="confirmUpdate2">
                        <input asp-for="@student.Id" hidden />

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Student Name</label>
                            <input asp-for="@student.Name" class="form-control" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Student Email</label>
                            <input asp-for="@student.Email" class="form-control" />
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">Course</label>
                            <select name="courseId" class="form-control">
                                @foreach (var course in courses)
                                {
                                    @if (course.Id == student.Course.Id)
                                    {
                                        <option value="@course.Id" selected>@course.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@course.Id">@course.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Update</button>
                            <a href="@Url.Action("Index", "Student")" class="btn btn-secondary btn-lg">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
        border: none;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .form-control {
        padding: 0.75rem;
        border-radius: 5px;
    }

        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
            border-color: #80bdff;
        }

    .btn {
        padding: 0.75rem;
        border-radius: 5px;
    }

    .form-label {
        margin-bottom: 0.5rem;
        color: #495057;
    }
</style>