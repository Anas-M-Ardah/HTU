@model List<Course>
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form id="courseForm" asp-action="create" method="post" class="p-5 border rounded bg-white shadow-lg">
                <h2 class="mb-5 text-center">Add a New Student</h2>

                <div class="form-group mb-4">
                    <label for="SName" class="form-label">Student Name</label>
                    <input type="text" class="form-control form-control-lg" name="SName" placeholder="Enter student name" required>
                </div>

                <div class="form-group mb-4">
                    <label for="Email" class="form-label">Student Email</label>
                    <input type="email" class="form-control form-control-lg" name="Email" placeholder="Student Email" required>
                </div>

                <div class="form-group mb-4">
                    <label for="courseSelect" class="form-label">Select Courses</label>
                    <select class="form-select form-select-lg" multiple name="CourseIds[]" id="courseSelect"
                            size="5" required>
                        @foreach (var course in Model)
                        {
                            <option value="@course.Id">
                                @course.Name - @course.Description (@course.InstructorName)
                            </option>
                        }
                    </select>
                    <div class="form-text text-muted">
                        Hold Ctrl (Windows) or Command (Mac) to select multiple courses
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">Submit</button>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>