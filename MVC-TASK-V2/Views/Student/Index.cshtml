@model List<Student>

<a href="/student/add" class="btn btn-primary mb-3">Add Student</a>
<table class="table table-striped table-bordered table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Student Name</th>
            <th>Email</th>
            <th>Course</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Student student in Model)
        {
            <tr>
                <td>@student.Name</td>
                <td>@student.Email</td>
                <td>@student.Course.Name</td>
                <td>
                    @*//try HTML.ActionLink*@
                    <a href="/student/update?sId=@student.Id" class="btn btn-warning">Update</a>
                    @Html.ActionLink("Update2", "Update2", "Student", new { sId = student.Id }, new { @class = "btn btn-warning" })
                </td>
            </tr>
        }
    </tbody>
</table>