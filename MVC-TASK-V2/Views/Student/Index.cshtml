@model List<Student>

<a href="/student/add" class="btn btn-primary mb-3">Add Student</a>
<table class="table table-striped table-bordered table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Student Name</th>
            <th>Email</th>
            <th>Courses</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Student student in Model)
        {
            <tr>
                <td>@student.Name</td>
                <td>@student.Email</td>
                <td>
                    @if (student.Courses != null && student.Courses.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var course in student.Courses)
                            {
                                <li>@course.Name</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">No courses enrolled</span>
                    }
                </td>
                <td>
                    <a href="/student/update?sId=@student.Id" class="btn btn-warning btn-sm">Update</a>
                </td>
            </tr>
        }
    </tbody>
</table>