@{
    Student student = ViewBag.Student;
    List<Course> courses = ViewBag.Courses;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Update Student</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="confirmUpdate">
                        <input asp-for="@student.Id" hidden />

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Student Name</label>
                            <input asp-for="@student.Name" class="form-control" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Student Email</label>
                            <input asp-for="@student.Email" class="form-control" />
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">Courses</label>
                            <select name="courseIds[]" class="form-select" multiple size="5">
                                @foreach (var course in courses)
                                {
                                    @if (student.Courses.Any(sc => sc.Id == course.Id))
                                    {
                                        <option value="@course.Id" selected>@course.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@course.Id">@course.Name</option>
                                    }
                                }
                            </select>
                            <div class="form-text text-muted">
                                Hold Ctrl (Windows) or Command (Mac) to select multiple courses
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Update</button>
                            <a href="@Url.Action("Index", "Student")" class="btn btn-secondary btn-lg">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
