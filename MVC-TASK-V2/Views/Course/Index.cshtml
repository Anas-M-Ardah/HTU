@model List<Course>

<a href="/course/add" class="btn btn-primary mb-3">Add Course</a>
<table class="table table-striped table-bordered table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Course Name</th>
            <th>Description</th>
            <th>Instructor</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Course course in Model)
        {
            <tr>
                <td>@course.Name</td>
                <td>@course.Description</td>
                <td>@course.InstructorName</td>
            </tr>
        }
    </tbody>
</table>