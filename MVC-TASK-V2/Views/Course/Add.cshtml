<div class="container mt-5">
    <form id="courseForm" asp-action="create" class="p-4 border rounded bg-white shadow-sm">
        <h2 class="mb-4 text-center">Add a New Course</h2>
        <div class="form-group">
            <label for="cName" class="font-weight-bold">Course Name</label>
            <input type="text" class="form-control" id="cName" name="cName" placeholder="Enter course name" required>
        </div>
        <div class="form-group">
            <label for="desc" class="font-weight-bold">Description</label>
            <textarea class="form-control" id="desc" name="desc" rows="3" placeholder="Enter course description" required></textarea>
        </div>
        <div class="form-group mb-4">
            <label for="instructor" class="font-weight-bold">Instructor Name</label>
            <input type="text" class="form-control" id="instructor" name="instructor" placeholder="Enter instructor name" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Submit</button>
    </form>
</div>